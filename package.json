{
  "name": "constructai-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first construction defect inspection MVP0",
  "scripts": {
    "bootstrap": "./scripts/bootstrap.sh",
    "quickstart": "./scripts/bootstrap.sh --run",
    "quickstart:full": "./scripts/bootstrap.sh --with-cv --run",
    "dev": "./scripts/dev-all.sh",
    "lint": "node scripts/lint.mjs",
    "start": "node src/server.js",
    "test": "npm run test:node && npm run test:python-contracts",
    "test:node": "CV_INFERENCE_MODE=mock node --test test/*.test.js",
    "test:python-contracts": "python3 -B -m unittest discover -s services/cv_inference/tests -p 'test_*.py'",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "package:hf": "node scripts/package-hf-space.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "audit": "node scripts/audit.mjs",
    "evidence:serve": "node scripts/evidence-serve.mjs",
    "evidence:manifest": "node scripts/evidence-manifest.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run hygiene && npm run audit",
    "benchmark:cv:validate": "node scripts/run-cv-benchmark.mjs",
    "benchmark:cv": "node scripts/run-cv-benchmark.mjs --live",
    "benchmark:cv:enforce": "node scripts/run-cv-benchmark.mjs --live --enforce",
    "cv:start": ".venv-cv/bin/python -m uvicorn services.cv_inference.app:app --host 127.0.0.1 --port 8001"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "postgres": "^3.4.9"
  }
}
