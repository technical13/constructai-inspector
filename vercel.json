{
  "functions": {
    "api/index.js": { "maxDuration": 180 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/try.html" },
    { "source": "/try", "destination": "/try.html" },
    {
      "source": "/api",
      "destination": "/api?__pathname=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api?__pathname=/api/$1"
    }
  ]
}
