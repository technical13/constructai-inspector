STORAGE_BACKEND=postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
CV_MODEL_DEFAULT=sam3
CV_INFERENCE_MODE=external

# Optional Hugging Face Gradio transport; REST remains the default.
# Keep the token server-side. All callers share its ZeroGPU daily quota.
# CV_INFERENCE_TRANSPORT=gradio
# CV_INFERENCE_TOKEN=YOUR_HF_READ_TOKEN
# PUBLIC_PREVIEW_MODE=true enables the stateless public page locally.
# Vercel always uses this public mode and blocks workspace storage APIs.
# SAM3_INFERENCE_URL=https://your-space.hf.space
# CV_DEVICE=cpu
# CV_CPU_THREADS=4
# SAM3_MODEL_PATH=/absolute/path/to/official/sam3/snapshot
# For gated downloads use local HF CLI login; on Spaces set HF_TOKEN as a secret.

# Optional isolated local storage for tests/demonstrations; never used for Neon.
# CONSTRUCTAI_DATA_DIR=/absolute/path/to/separate-demo-data
# CV_INFERENCE_MODE=disabled disables live analysis while keeping precomputed demos.

# Bounded inference: общий deadline и лимиты очереди на каждый endpoint.
# Значения по умолчанию безопасны для одного Mac с Apple Silicon.
# CV_INFERENCE_TIMEOUT_MS=120000
# CV_INFERENCE_MAX_CONCURRENCY=1
# CV_INFERENCE_MAX_QUEUE=8

# Внутренние лимиты Python CV-service для прямых запросов в обход Node API.
# CV_SERVICE_MAX_CONCURRENCY=1
# CV_SERVICE_MAX_QUEUE=8
# CV_SERVICE_QUEUE_TIMEOUT_SECONDS=10
# CV_BENCHMARK_TIMEOUT_SECONDS=180

# Локальное редактирование public/demo. На Vercel автоматически read-only.
# DEMO_LIBRARY_WRITABLE=true

# Опционально: если настроен Vercel Blob, изображения и HTML-акты будут
# храниться как публичные файлы, а не как записи в Postgres.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Опционально: endpoint'ы готовых предобученных моделей.
# Если не заданы, в UI селектор всё равно будет виден, но модель будет помечена как
# "не подключена".
# DEEPCRACK_INFERENCE_URL=http://127.0.0.1:8001
# GROUNDING_DINO_INFERENCE_URL=http://127.0.0.1:8001
# SAM3_INFERENCE_URL=http://127.0.0.1:8001
# FLORENCE2_INFERENCE_URL=http://127.0.0.1:8001
# GENERAL_CV_INFERENCE_URL=http://127.0.0.1:8004

# Опционально: точечная настройка zero-shot / foundation моделей.
# GROUNDING_DINO_MIN_CONFIDENCE=0.28
# GROUNDING_DINO_MAX_BOXES_PER_TYPE=2
# FLORENCE2_MODEL_ID=florence-community/Florence-2-base-ft
# FLORENCE2_TASK=<OPEN_VOCABULARY_DETECTION>
